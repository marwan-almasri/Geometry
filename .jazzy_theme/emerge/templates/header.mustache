<header class="header">
  <div class="header-inner">
    <p class="header-col header-col--primary">
      <a class="header-link" href="{{path_to_root}}index.html">
        <span class="header-logo-mark"></span>
        {{docs_title}}
      </a>
      {{#doc_coverage}}<span class="doc-coverage">({{doc_coverage}}% documented)</span>{{/doc_coverage}}
    </p>

    {{^disable_search}}
    <div class="header-col header-col--search">
      <form role="search" action="{{path_to_root}}search.json">
        <input type="text" placeholder="Search documentation" data-typeahead>
      </form>
    </div>
    {{/disable_search}}

    <div class="header-col header-col--actions">
      {{#source_host_url}}
      <a class="header-link header-link--icon" href="{{.}}" title="View on {{source_host_name}}">
        <img class="header-icon" src="{{path_to_root}}img/{{source_host_image}}" alt="{{source_host_name}}"/>
      </a>
      {{/source_host_url}}

      {{#source_host_url}}
      <a class="get-started-btn" href="{{.}}" target="_blank" rel="noopener">
        <span class="get-started-btn__shimmer"></span>
        <span class="get-started-btn__text">Get Started</span>
      </a>
      {{/source_host_url}}
      {{^source_host_url}}
      <a class="get-started-btn" href="{{path_to_root}}index.html">
        <span class="get-started-btn__shimmer"></span>
        <span class="get-started-btn__text">Get Started</span>
      </a>
      {{/source_host_url}}

      {{#dash_url}}
      <a class="header-link" href="{{dash_url}}" title="Install in Dash">
        <img class="header-icon" src="{{path_to_root}}img/dash.png" alt="Dash"/>
      </a>
      {{/dash_url}}
    </div>
  </div>
</header>
